APP_ENV=development
DATABASE_PATH=data/phinix.db
# Generate a random token of at least 32 characters. Never commit the real .env.
ADMIN_TOKEN=

# Free Render viewer: set both flags true, with the Supabase server key in secret settings.
SNAPSHOT_MODE=false
SUPABASE_SNAPSHOT=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Scheduled runner uses Supabase; private legacy repositories can still use github.
PHINIX_STATE_BACKEND=supabase

# HackerOne Hacker API, read-only access.
HACKERONE_USERNAME=
HACKERONE_TOKEN=
HACKERONE_COLLECTIONS=hacktivity,reports

# Bugcrowd Hacker API ID:secret pair, without the 'Token ' prefix.
BUGCROWD_TOKEN=
BUGCROWD_COLLECTIONS=engagements,submissions

# Incoming webhook attached to the intended Discord channel.
DISCORD_WEBHOOK_URL=
DISCORD_CHANNEL_NAME=phinix
DISCORD_INCLUDE_DETAILS=false

POLL_INTERVAL_SECONDS=300
PAGE_SIZE=50
PAGES_PER_CYCLE=3
MAX_RETRIES=3
HTTP_TIMEOUT_SECONDS=20
AUTH_COOLDOWN_SECONDS=3600
NOTIFY_HISTORY=false

# Comma-separated, case-insensitive exact matches; keywords use substring matches.
# All non-empty rule groups must match; any keyword within its group can match.
NOTIFY_PROVIDERS=
NOTIFY_PROGRAMS=
NOTIFY_CATEGORIES=
NOTIFY_SEVERITIES=
NOTIFY_KEYWORDS=

INTIGRITI_ENABLED=false
INTIGRITI_TOKEN=
INTIGRITI_COLLECTIONS=programs,activities
# Revisit the most recent 50 activities each scan; not a full historical import.
INTIGRITI_ACTIVITY_WINDOW=50
INTIGRITI_DOMAINS_ONLY=true
INTIGRITI_SCOPE_JOBS_PER_CYCLE=12
# Optional recognized phinix-events-v1 JSON file. Unknown formats fail startup.
# LEGACY_STATE_PATH=
